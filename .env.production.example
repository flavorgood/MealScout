# MealScout Production Environment (Render Backend)
# Copy to Render dashboard as environment variables

# Core Settings
NODE_ENV=production
PORT=5001
BETA_MODE=true

# Database (Neon PostgreSQL - same for dev and prod)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Security Secrets (GENERATE NEW VALUES FOR PRODUCTION)
SESSION_SECRET=<GENERATE_RANDOM_64_CHAR_STRING>

# Existing admin hashes are never replaced during ordinary startup. Temporarily
# set this to true only for a deliberate one-time rotation, then return it to false.
ADMIN_PASSWORD_SYNC_ON_STARTUP=false
OWNER_AI_PUBLIC_BASE_URL=https://www.mealscout.us
INCIDENT_SIGNATURE_SECRET=<GENERATE_RANDOM_64_CHAR_STRING>

# Action API Integration (MealScout; public discovery reads only)
# Static integration tokens do not establish user identity or authorize writes.
# Primary: MEALSCOUT_ACTION_TOKEN or MEALSCOUT_ACTION_TOKENS
MEALSCOUT_ACTION_TOKEN=<REPLACE_WITH_PRODUCTION_TOKEN>

# ===== STRIPE / PAYMENTS (REQUIRED IN PRODUCTION) =====
# preLaunchGate.mjs / productionReadinessGate.mjs treat the first three as
# hard requirements when payments are enabled.
STRIPE_SECRET_KEY=<REPLACE_WITH_LIVE_SECRET_KEY>
VITE_STRIPE_PUBLIC_KEY=<REPLACE_WITH_LIVE_PUBLISHABLE_KEY>
STRIPE_WEBHOOK_SECRET=<REPLACE_WITH_WEBHOOK_SIGNING_SECRET>
# Server-side publishable fallbacks used by config endpoints (optional).
STRIPE_PUBLIC_KEY=
STRIPE_PUBLISHABLE_KEY=
# In production NODE_ENV!=development, so signatures are always verified.
# These dev-only escape hatches MUST stay false/unset in production.
STRIPE_WEBHOOK_FORCE_VERIFY=true
STRIPE_WEBHOOK_DEV_ALLOW_UNSIGNED=false
MEALSCOUT_BYPASS_STRIPE=false
MEALSCOUT_TEST_MODE=false

# CORS Origins (Production Frontend)
CLIENT_ORIGIN=https://mealscout.us
ALLOWED_ORIGINS=https://mealscout.us,https://www.mealscout.us,https://thetradescout.com,https://www.thetradescout.com

# Public URL (Render Backend Subdomain)
PUBLIC_BASE_URL=https://api.mealscout.thetradescout.com
# Canonical website origin for sitemap/robots output
SITEMAP_SITE_URL=https://www.mealscout.us

# Email + incident notification configuration
# Required for `npm run checklist:security:prod` and incident staging tests.
# Use real secret-manager values in Render; do not commit live keys or recipients.
BREVO_API_KEY=<REPLACE_WITH_BREVO_API_KEY>
INCIDENT_EMAIL_RECIPIENTS=alerts@example.com,security@example.com

# Automated marketing / onboarding drip emails — OFF by default; nothing
# sends until they are deliberately enabled. Set
# AUTOMATED_MARKETING_EMAILS_ENABLED=true only as a deliberate opt-in.
# (Per-recipient email settings still apply.)
# AUTOMATED_MARKETING_EMAILS_ENABLED=true

# SMS (Brevo Transactional SMS). US delivery requires a Brevo-registered
# toll-free number or 10DLC sender - the "MealScout" alphanumeric fallback in
# code is NOT deliverable to US numbers. Set once Brevo's SMS compliance
# registration (help.brevo.com articles 28255350696466 / 8840663406738) is approved.
BREVO_SMS_SENDER=<REPLACE_WITH_REGISTERED_TFN_OR_10DLC_NUMBER>
BREVO_SMS_ORGANISATION_PREFIX=

# Optional unless CHECKLIST_REQUIRE_SLACK=true / CHECKLIST_REQUIRE_SMS=true
SLACK_WEBHOOK_URL=
INCIDENT_SMS_RECIPIENTS=

# OAuth (Optional - if enabling Google/Facebook login later)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ===== GOOGLE MAPS =====
# Server-only key (Geocoding, Places, Routes, Address Validation, Nearby Search)
# Never reuse this value in a VITE_* variable or return it to a browser.
# Restrict by API and to your Render server egress/IP when available.
GOOGLE_MAPS_API_KEY=
# Browser-only key (Maps JavaScript API) - injected by Vite at build time.
# Restrict by API and HTTP referrer to https://mealscout.us/*.
VITE_GOOGLE_MAPS_WEB_API_KEY=
# Optional: Map ID for Advanced Markers
VITE_GOOGLE_MAPS_MAP_ID=
# Enable Socket.IO live location broadcasting
VITE_ENABLE_SOCKETS=true

# Host partner lead magnet + drip
HOST_PARTNER_LEADS_ENABLED=true
HOST_PARTNER_DRIP_ENABLED=true
HOST_PARTNER_LOOKBACK_DAYS=45
HOST_PARTNER_EMAIL_COOLDOWN_MINUTES=30

# IndexNow acceleration — ON by default; nothing to set to enable it.
# Set INDEXNOW_ENABLED=false only as an opt-out kill-switch.
# INDEXNOW_ENABLED=false
INDEXNOW_HOST=www.mealscout.us
INDEXNOW_KEY=<ADD_INDEXNOW_KEY>
INDEXNOW_KEY_LOCATION=https://www.mealscout.us/<ADD_INDEXNOW_KEY>.txt
