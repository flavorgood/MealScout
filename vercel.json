{
  "framework": null,
  "installCommand": "npm ci --include=dev --ignore-scripts --no-audit --no-fund",
  "buildCommand": "node scripts/qa/discovery-hosted-proof.mjs",
  "outputDirectory": ".discovery-proof",
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }, { "key": "Cache-Control", "value": "no-store" }] }]
