{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mealscout.us"
        }
      ],
      "destination": "https://www.mealscout.us/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/static/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://mealscout.onrender.com/sitemap.xml"
    },
    {
      "source": "/sitemap-:name.xml",
      "destination": "https://mealscout.onrender.com/sitemap-:name.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "https://mealscout.onrender.com/llms.txt"
    },
    {
      "source": "/ai.txt",
      "destination": "https://mealscout.onrender.com/ai.txt"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://mealscout.onrender.com/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://mealscout.onrender.com/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "https://mealscout.onrender.com/.well-known/oauth-protected-resource/:path*"
    },
    {
      "source": "/:indexNowKey([A-Za-z0-9_-]{8,128}).txt",
      "destination": "https://mealscout.onrender.com/:indexNowKey.txt"
    },
    {
      "source": "/for-food-trucks",
      "destination": "https://mealscout.onrender.com/for-food-trucks",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]|[Ss][Ll][Uu][Rr][Pp]|[Cc][Hh][Aa][Tt][Gg][Pp][Tt]-[Uu][Ss][Ee][Rr]|[Aa][Nn][Tt][Hh][Rr][Oo][Pp][Ii][Cc]-[Aa][Ii]|[Cc][Oo][Hh][Ee][Rr][Ee]-[Aa][Ii]).*"
        }
      ]
    },
    {
      "source": "/for-restaurants",
      "destination": "https://mealscout.onrender.com/for-restaurants",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]|[Ss][Ll][Uu][Rr][Pp]|[Cc][Hh][Aa][Tt][Gg][Pp][Tt]-[Uu][Ss][Ee][Rr]|[Aa][Nn][Tt][Hh][Rr][Oo][Pp][Ii][Cc]-[Aa][Ii]|[Cc][Oo][Hh][Ee][Rr][Ee]-[Aa][Ii]).*"
        }
      ]
    },
    {
      "source": "/for-hosts",
      "destination": "https://mealscout.onrender.com/for-hosts",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]|[Ss][Ll][Uu][Rr][Pp]|[Cc][Hh][Aa][Tt][Gg][Pp][Tt]-[Uu][Ss][Ee][Rr]|[Aa][Nn][Tt][Hh][Rr][Oo][Pp][Ii][Cc]-[Aa][Ii]|[Cc][Oo][Hh][Ee][Rr][Ee]-[Aa][Ii]).*"
        }
      ]
    },
    {
      "source": "/host-location-partner",
      "destination": "https://mealscout.onrender.com/host-location-partner",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]|[Ss][Ll][Uu][Rr][Pp]|[Cc][Hh][Aa][Tt][Gg][Pp][Tt]-[Uu][Ss][Ee][Rr]|[Aa][Nn][Tt][Hh][Rr][Oo][Pp][Ii][Cc]-[Aa][Ii]|[Cc][Oo][Hh][Ee][Rr][Ee]-[Aa][Ii]).*"
        }
      ]
    },
    {
      "source": "/food-trucks/:city/:cuisine",
      "destination": "https://mealscout.onrender.com/food-trucks/:city/:cuisine"
    },
    {
      "source": "/food-trucks/:city",
      "destination": "https://mealscout.onrender.com/food-trucks/:city"
    },
    {
      "source": "/food-trucks-today/:city",
      "destination": "https://mealscout.onrender.com/food-trucks-today/:city"
    },
    {
      "source": "/food-truck-catering/:city",
      "destination": "https://mealscout.onrender.com/food-truck-catering/:city"
    },
    {
      "source": "/book-food-truck/:city",
      "destination": "https://mealscout.onrender.com/book-food-truck/:city"
    },
    {
      "source": "/city/:city/food",
      "destination": "https://mealscout.onrender.com/city/:city/food"
    },
    {
      "source": "/deals-today/:city",
      "destination": "https://mealscout.onrender.com/deals-today/:city"
    },
    {
      "source": "/events-today/:city",
      "destination": "https://mealscout.onrender.com/events-today/:city"
    },
    {
      "source": "/locations-with-trucks/:city",
      "destination": "https://mealscout.onrender.com/locations-with-trucks/:city"
    },
    {
      "source": "/cuisine/:cuisine/:city",
      "destination": "https://mealscout.onrender.com/cuisine/:cuisine/:city"
    },
    {
      "source": "/cuisine/:cuisine",
      "destination": "https://mealscout.onrender.com/cuisine/:cuisine"
    },
    {
      "source": "/deals/featured",
      "destination": "/index.html"
    },
    {
      "source": "/deals/:city",
      "destination": "https://mealscout.onrender.com/deals/:city"
    },
    {
      "source": "/events/public",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://mealscout.onrender.com/api/$1"
    },
    {
      "source": "/:kind(restaurant|truck|bar|caterer|private-chef|chef|location|event|events|deal|supplier|suppliers|p|video)/:path*",
      "destination": "https://mealscout.onrender.com/:kind/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://mealscout.onrender.com/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://mealscout.onrender.com/admin/:path*"
    },
    {
      "source": "/dashboard",
      "destination": "https://mealscout.onrender.com/dashboard"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://mealscout.onrender.com/dashboard/:path*"
    },
    {
      "source": "/vendor-dashboard",
      "destination": "https://mealscout.onrender.com/vendor-dashboard"
    },
    {
      "source": "/vendor-dashboard/:path*",
      "destination": "https://mealscout.onrender.com/vendor-dashboard/:path*"
    },
    {
      "source": "/supplier-portal",
      "destination": "https://mealscout.onrender.com/supplier-portal"
    },
    {
      "source": "/supplier-portal/:path*",
      "destination": "https://mealscout.onrender.com/supplier-portal/:path*"
    },
    {
      "source": "/:path((?!assets/|static/).*)",
      "destination": "/index.html"
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "https://mealscout.onrender.com/sitemap.xml"
    },
    {
      "src": "/sitemap-([\\w-]+)\\.xml",
      "dest": "https://mealscout.onrender.com/sitemap-$1.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "https://mealscout.onrender.com/robots.txt"
    },
    {
      "src": "/llms.txt",
      "dest": "https://mealscout.onrender.com/llms.txt"
    },
    {
      "src": "/ai.txt",
      "dest": "https://mealscout.onrender.com/ai.txt"
    },
    {
      "src": "/\\.well-known/oauth-authorization-server",
      "dest": "https://mealscout.onrender.com/.well-known/oauth-authorization-server"
    },
    {
      "src": "/\\.well-known/oauth-protected-resource",
      "dest": "https://mealscout.onrender.com/.well-known/oauth-protected-resource"
    },
    {
      "src": "/\\.well-known/oauth-protected-resource/(.*)",
      "dest": "https://mealscout.onrender.com/.well-known/oauth-protected-resource/$1"
    },
    {
      "src": "/([A-Za-z0-9_-]{8,128})\\.txt",
      "dest": "https://mealscout.onrender.com/$1.txt"
    },
    {
      "src": "/for-food-trucks",
      "dest": "https://mealscout.onrender.com/for-food-trucks",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]|[Ss][Ll][Uu][Rr][Pp]|[Cc][Hh][Aa][Tt][Gg][Pp][Tt]-[Uu][Ss][Ee][Rr]|[Aa][Nn][Tt][Hh][Rr][Oo][Pp][Ii][Cc]-[Aa][Ii]|[Cc][Oo][Hh][Ee][Rr][Ee]-[Aa][Ii]).*"
        }
      ]
    },
    {
      "src": "/for-restaurants",
      "dest": "https://mealscout.onrender.com/for-restaurants",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]|[Ss][Ll][Uu][Rr][Pp]|[Cc][Hh][Aa][Tt][Gg][Pp][Tt]-[Uu][Ss][Ee][Rr]|[Aa][Nn][Tt][Hh][Rr][Oo][Pp][Ii][Cc]-[Aa][Ii]|[Cc][Oo][Hh][Ee][Rr][Ee]-[Aa][Ii]).*"
        }
      ]
    },
    {
      "src": "/for-hosts",
      "dest": "https://mealscout.onrender.com/for-hosts",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]|[Ss][Ll][Uu][Rr][Pp]|[Cc][Hh][Aa][Tt][Gg][Pp][Tt]-[Uu][Ss][Ee][Rr]|[Aa][Nn][Tt][Hh][Rr][Oo][Pp][Ii][Cc]-[Aa][Ii]|[Cc][Oo][Hh][Ee][Rr][Ee]-[Aa][Ii]).*"
        }
      ]
    },
    {
      "src": "/host-location-partner",
      "dest": "https://mealscout.onrender.com/host-location-partner",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb][Oo][Tt]|[Cc][Rr][Aa][Ww][Ll][Ee][Rr]|[Ss][Pp][Ii][Dd][Ee][Rr]|[Ss][Ll][Uu][Rr][Pp]|[Cc][Hh][Aa][Tt][Gg][Pp][Tt]-[Uu][Ss][Ee][Rr]|[Aa][Nn][Tt][Hh][Rr][Oo][Pp][Ii][Cc]-[Aa][Ii]|[Cc][Oo][Hh][Ee][Rr][Ee]-[Aa][Ii]).*"
        }
      ]
    },
    {
      "src": "/assets/(.*\\.(?:js|css))",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/static/(.*\\.(?:js|css))",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/food-trucks/([^/]+)/([^/]+)",
      "dest": "https://mealscout.onrender.com/food-trucks/$1/$2"
    },
    {
      "src": "/food-trucks/([^/]+)",
      "dest": "https://mealscout.onrender.com/food-trucks/$1"
    },
    {
      "src": "/food-trucks-today/([^/]+)",
      "dest": "https://mealscout.onrender.com/food-trucks-today/$1"
    },
    {
      "src": "/food-truck-catering/([^/]+)",
      "dest": "https://mealscout.onrender.com/food-truck-catering/$1"
    },
    {
      "src": "/book-food-truck/([^/]+)",
      "dest": "https://mealscout.onrender.com/book-food-truck/$1"
    },
    {
      "src": "/city/([^/]+)/food",
      "dest": "https://mealscout.onrender.com/city/$1/food"
    },
    {
      "src": "/deals-today/([^/]+)",
      "dest": "https://mealscout.onrender.com/deals-today/$1"
    },
    {
      "src": "/events-today/([^/]+)",
      "dest": "https://mealscout.onrender.com/events-today/$1"
    },
    {
      "src": "/locations-with-trucks/([^/]+)",
      "dest": "https://mealscout.onrender.com/locations-with-trucks/$1"
    },
    {
      "src": "/cuisine/([^/]+)/([^/]+)",
      "dest": "https://mealscout.onrender.com/cuisine/$1/$2"
    },
    {
      "src": "/cuisine/([^/]+)",
      "dest": "https://mealscout.onrender.com/cuisine/$1"
    },
    {
      "src": "/deals/featured",
      "dest": "/index.html"
    },
    {
      "src": "/deals/([^/]+)",
      "dest": "https://mealscout.onrender.com/deals/$1"
    },
    {
      "src": "/events/public",
      "dest": "/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://mealscout.onrender.com/api/$1"
    },
    {
      "src": "/(restaurant|truck|bar|caterer|private-chef|chef|location|event|events|deal|supplier|suppliers|p|video)/(.*)",
      "dest": "https://mealscout.onrender.com/$1/$2"
    },
    {
      "src": "/admin(/.*)?",
      "dest": "https://mealscout.onrender.com/admin$1"
    },
    {
      "src": "/dashboard(/.*)?",
      "dest": "https://mealscout.onrender.com/dashboard$1"
    },
    {
      "src": "/vendor-dashboard(/.*)?",
      "dest": "https://mealscout.onrender.com/vendor-dashboard$1"
    },
    {
      "src": "/supplier-portal(/.*)?",
      "dest": "https://mealscout.onrender.com/supplier-portal$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*\\.(?:js|css))",
      "status": 404
    },
    {
      "src": "/static/(.*\\.(?:js|css))",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}