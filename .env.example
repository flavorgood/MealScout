# From .env
VERCEL_OIDC_TOKEN=
DATABASE_URL=
# Use only with a disposable PostgreSQL database on loopback for local migration proof.
# The deploy migrator rejects this mode in Render services.
MEALSCOUT_LOCAL_POSTGRES_MIGRATION=false
# Disposable verification services only: skip startup schedulers/admin bootstrap.
# This does not block provider calls from request routes; use no provider credentials
# and keep host/email flows off in the isolated environment.
# Refused on the live MealScout Render service; keep false for ordinary deployments.
MEALSCOUT_ISOLATED_VERIFICATION=false
# Opt in to a numeric loopback pg runtime only alongside isolated verification.
# Never set on Render; URL parameters, fragments, remote hosts and database names
# outside mealscout_isolated_* are rejected. Use a cloned disposable database.
MEALSCOUT_LOCAL_POSTGRES_RUNTIME=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Existing admin hashes are never replaced during ordinary startup. Temporarily
# set this to true only for a deliberate one-time rotation, then return it to false.
ADMIN_PASSWORD_SYNC_ON_STARTUP=false
SESSION_SECRET=
OWNER_AI_PUBLIC_BASE_URL=https://www.mealscout.us
CLIENT_ORIGIN=

# MealScout Action API (public discovery reads only; static tokens cannot perform user-scoped writes)
MEALSCOUT_ACTION_TOKEN=

# ===== STRIPE / PAYMENTS =====
# Server-side secret key (sk_...). Required for any Stripe call.
STRIPE_SECRET_KEY=
# Publishable key returned to the browser. VITE_STRIPE_PUBLIC_KEY is the one
# read by the client build; STRIPE_PUBLIC_KEY / STRIPE_PUBLISHABLE_KEY are
# server-side fallbacks used by the config endpoints.
VITE_STRIPE_PUBLIC_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...). Required outside development.
STRIPE_WEBHOOK_SECRET=
# Set true to require Stripe signature verification even in development.
STRIPE_WEBHOOK_FORCE_VERIFY=false
# Escape hatch: set true to ACCEPT unsigned webhook payloads in development.
# Off by default - unsigned dev payloads are rejected unless this is true.
STRIPE_WEBHOOK_DEV_ALLOW_UNSIGNED=false
# --- Test / bypass toggles (must be OFF in production) ---
MEALSCOUT_BYPASS_STRIPE=false
MEALSCOUT_TEST_MODE=false
MEALSCOUT_TEST_PROMOS_REQUIRE_ADMIN=true
MEALSCOUT_TEST_PROMO_ALLOWLIST=
MEALSCOUT_TEST_IP=

# --- Parking Pass ---
PARKING_PASS_HOLD_TTL_MINUTES=15

# --- Pickup order fees ---
PICKUP_ORDER_MEALSCOUT_FEE_CENTS=
PICKUP_ORDER_STRIPE_FEE_BPS=
PICKUP_ORDER_STRIPE_FEE_FIXED_CENTS=

# --- Supplier order fees / ACH thresholds ---
SUPPLIER_ORDER_ACH_DEFAULT_THRESHOLD_CENTS=
SUPPLIER_ORDER_ACH_DISCOUNT_THRESHOLD_CENTS=
SUPPLIER_ORDER_ACH_DISCOUNT_CENTS=
SUPPLIER_ORDER_ACH_FEE_BPS=
SUPPLIER_ORDER_ACH_FEE_FIXED_CENTS=
SUPPLIER_ORDER_ACH_FEE_CAP_CENTS=
SUPPLIER_ORDER_STRIPE_FEE_BPS=
SUPPLIER_ORDER_STRIPE_FEE_FIXED_CENTS=
SUPPLIER_ORDER_MS_PROCESSING_FEE_BPS=
SUPPLIER_ORDER_MS_PROCESSING_FIXED_CENTS=
SUPPLIER_ORDER_PLATFORM_FIXED_CENTS=

# From .env.local
